<Window x:Class="ZoomBridge.UI.TrayFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZoomBridge"
        Width="350" Height="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Auto"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <!-- Tarjeta flotante 100% OPACA y sólida (sin transparencias hacia las ventanas de atrás) -->
    <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="14"
            Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="3" Opacity="0.3" Color="#000000"/>
        </Border.Effect>

        <DockPanel LastChildFill="True">
            <!-- Encabezado con Icono y Nombre -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" x:Name="ImgFlyoutAppIcon" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       UseLayoutRounding="True" SnapsToDevicePixels="True"/>
                <TextBlock Grid.Column="1" Text="ZoomBridge" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" 
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                <Button Grid.Column="2" x:Name="BtnOpenSettings" ToolTip="Abrir ZoomBridge"
                        Padding="8,4" MinHeight="28" Cursor="Hand" Click="BtnOpenFull_Click">
                    <TextBlock Text="&#xE740;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </Button>
            </Grid>

            <!-- Pie: Salir -->
            <Border DockPanel.Dock="Bottom" Padding="0,8,0,0">
                <Button x:Name="BtnExit" Padding="12,6" MinHeight="30" HorizontalAlignment="Right" Cursor="Hand" Click="BtnExit_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Salir de ZoomBridge" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Border>

            <!-- Tarjeta de Estado del Agente (Fondo sólido opaco) -->
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,8">
                <StackPanel>
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="StateDot" Grid.Column="0" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="#10B981"/>
                        <TextBlock x:Name="TxtStateTitle" Grid.Column="1" Text="Todo al día" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </Grid>

                    <TextBlock x:Name="TxtStateSubtitle" Text="Tus reuniones se respaldan automáticamente al terminar" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="16,0,0,0"/>

                    <ProgressBar x:Name="ProgressTransfer" Height="3" Margin="0,6,0,0" Visibility="Collapsed"
                                 Background="{DynamicResource CardStrokeColorDefaultBrush}"/>
                </StackPanel>
            </Border>

            <!-- Acciones Rápidas (Opacas y accesibles) -->
            <StackPanel VerticalAlignment="Center">
                <Button x:Name="BtnScanNow" Margin="0,1,0,1" Padding="10,7" MinHeight="34" HorizontalContentAlignment="Left" Cursor="Hand" Click="BtnScanNow_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Comprobar reuniones ahora" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnOpenZoomFolder" Margin="0,1,0,1" Padding="10,7" MinHeight="34" HorizontalContentAlignment="Left" Cursor="Hand" Click="BtnOpenZoomFolder_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xED25;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="Carpeta de Zoom" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnOpenDestFolder" Margin="0,1,0,1" Padding="10,7" MinHeight="34" HorizontalContentAlignment="Left" Cursor="Hand" Click="BtnOpenDestFolder_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE753;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="Carpeta de respaldo en la nube" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnOpenFull" Margin="0,1,0,1" Padding="10,7" MinHeight="34" HorizontalContentAlignment="Left" Cursor="Hand" Click="BtnOpenFull_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="Abrir ZoomBridge" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>

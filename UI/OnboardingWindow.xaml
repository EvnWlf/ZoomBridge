<Window x:Class="ZoomBridge.UI.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZoomBridge - Configuración Inicial" 
        Height="540" Width="720"
        MinHeight="500" MinWidth="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Auto"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Indicador de pasos superior -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ProgressBar x:Name="StepBar1" Grid.Column="0" Height="3" Value="100" Margin="0,0,6,0"/>
            <ProgressBar x:Name="StepBar2" Grid.Column="1" Height="3" Value="0" Margin="3,0,3,0"/>
            <ProgressBar x:Name="StepBar3" Grid.Column="2" Height="3" Value="0" Margin="6,0,0,0"/>
        </Grid>

        <!-- Contenedor dinámico de pasos -->
        <Grid Grid.Row="1">
            <!-- PASO 1: Bienvenida e Introducción -->
            <StackPanel x:Name="Step1Panel" Visibility="Visible" VerticalAlignment="Center">
                <Image x:Name="ImgWelcomeIcon" Width="48" Height="48" HorizontalAlignment="Left" Margin="0,0,0,16"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       UseLayoutRounding="True" SnapsToDevicePixels="True"/>

                <TextBlock Text="Bienvenido a ZoomBridge" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="Agente local y privado para respaldar grabaciones de reuniones en tu nube sincronizada." 
                           FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,24"/>

                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Privacidad local garantizada" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Ningún archivo ni dato sale de tu equipo. Todo opera de forma privada y local." FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE753;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Sin APIs ni tokens corporativos" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Se sincroniza directamente con tu carpeta de OneDrive, SharePoint o almacenamiento local existente." FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- PASO 2: Selección Obligatoria de Carpetas -->
            <StackPanel x:Name="Step2Panel" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock Text="Carpetas de Trabajo" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="Especifica dónde Zoom guarda las reuniones y dónde deseas archivarlas." 
                           FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,20"/>

                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel>
                        <!-- Origen -->
                        <TextBlock Text="Carpeta de grabaciones de Zoom (Origen)" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Ubicación donde tu cliente de Zoom guarda las grabaciones locales" FontSize="12" Margin="0,2,0,8"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtZoomFolder" MinHeight="36" Padding="10,6" TextChanged="ValidateInputs"/>
                            <Button Grid.Column="1" Content="Examinar..." MinHeight="36" Padding="14,6" Margin="8,0,0,0" Cursor="Hand" Click="BtnBrowseZoom_Click"/>
                        </Grid>

                        <!-- Destino -->
                        <TextBlock Text="Carpeta de respaldo (Destino)" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Carpeta sincronizada con SharePoint, OneDrive, Google Drive o disco" FontSize="12" Margin="0,2,0,8"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtDestFolder" MinHeight="36" Padding="10,6" TextChanged="ValidateInputs"/>
                            <Button Grid.Column="1" Content="Examinar..." MinHeight="36" Padding="14,6" Margin="8,0,0,0" Cursor="Hand" Click="BtnBrowseDest_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- PASO 3: Cómo opera el System Tray -->
            <StackPanel x:Name="Step3Panel" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock Text="Funcionamiento en Segundo Plano" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="ZoomBridge opera de manera silenciosa junto al reloj de Windows." 
                           FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,20"/>

                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE706;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Se cierra a la bandeja del sistema" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Al cerrar la ventana, el agente sigue vigilando tus reuniones. Haz un clic en su icono para ver el menú rápido o doble clic para abrir la app." 
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE714;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Copia inteligente y segura" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Espera a que Zoom termine de codificar antes de transferir y verifica que cada archivo esté íntegro antes de limpiar el origen." 
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Barra inferior de navegación -->
        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnBack" Grid.Column="0" Content="Anterior" MinHeight="36" Padding="16,6"
                    Visibility="Collapsed" Cursor="Hand" Click="BtnBack_Click"/>

            <Button x:Name="BtnNext" Grid.Column="2" Content="Siguiente" Style="{DynamicResource AccentButtonStyle}"
                    MinHeight="36" Padding="20,6" Cursor="Hand" Click="BtnNext_Click"/>
        </Grid>
    </Grid>
</Window>
